# Copy to .env.local (never commit it). On Vercel, add these under Project → Settings → Environment Variables.

# Mapbox public token (pk.…). Restrict it to your Vercel domain + localhost in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Backend base URL INCLUDING /api/v1. Leave empty to run fully in the browser
# on the recorded results in public/snapshot.json (demo mode).
# local:  http://localhost:8000/api/v1
# render: https://qadr-api.onrender.com/api/v1
VITE_API_URL=

# Supabase (anon key only; the service key belongs on the backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show one-click persona switcher (Citizen / Field crew / Command). Set false in production.
VITE_DEMO_LOGINS=true
